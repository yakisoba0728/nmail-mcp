{
  "name": "nmail-mcp",
  "version": "1.1.4",
  "description": "MCP server for Naver Mail (네이버 메일): search, read, send and organize mail over IMAP/SMTP. Runs on Cloudflare Workers, Node.js, Docker or stdio.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "naver",
    "naver-mail",
    "chatgpt",
    "claude",
    "cloudflare-workers",
    "imap",
    "smtp",
    "email",
    "korean",
    "ai-agents",
    "llm",
    "cursor",
    "docker",
    "self-hosted",
    "stdio"
  ],
  "license": "Apache-2.0",
  "author": "yakisoba0728",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yakisoba0728/nmail-mcp.git"
  },
  "homepage": "https://github.com/yakisoba0728/nmail-mcp#readme",
  "bugs": "https://github.com/yakisoba0728/nmail-mcp/issues",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node test/e2e.mjs",
    "bench": "vitest run --config bench/vitest.config.ts",
    "build": "node scripts/build-node.mjs",
    "start": "node dist/nmail-mcp.mjs serve"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "nodemailer": "10.4.0",
    "postal-mime": "4.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261123.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "^3.5.13",
    "esbuild": "0.28.2",
    "imapflow": "2.11.0",
    "smtp-server": "^3.21.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "workerd@1.20261104.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "bin": {
    "nmail-mcp": "dist/nmail-mcp.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "files": [
    "dist/nmail-mcp.mjs"
  ]
}
